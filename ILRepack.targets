<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LongshipUpgradesPackageName Condition="'$(LongshipUpgradesPackageName)' == ''">LongshipUpgrades</LongshipUpgradesPackageName>
  </PropertyGroup>

  <Target Name="UpdateLongshipUpgradesTranslations"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(MSBuildProjectDirectory)\UpdateTranslations.ps1')">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\UpdateTranslations.ps1&quot;" />
    <Message Text="Updated embedded translations before build." Importance="High" />
  </Target>

  <Target Name="InitializeLongshipUpgradesPackageProperties">
    <PropertyGroup>
      <ResolvedLongshipUpgradesR2ModManProfilePluginsDir Condition="'$(R2ModManProfilePluginsDir)' != ''">$(R2ModManProfilePluginsDir)</ResolvedLongshipUpgradesR2ModManProfilePluginsDir>
      <ResolvedLongshipUpgradesR2ModManProfilePluginsDir Condition="'$(ResolvedLongshipUpgradesR2ModManProfilePluginsDir)' == ''">D:\r2modman\Valheim\profiles\beta\BepInEx\plugins\shudnal-$(LongshipUpgradesPackageName)\</ResolvedLongshipUpgradesR2ModManProfilePluginsDir>
      <LongshipUpgradesThunderstorePackageDir>$(MSBuildProjectDirectory)\package\thunderstore\$(LongshipUpgradesPackageName)\</LongshipUpgradesThunderstorePackageDir>
      <LongshipUpgradesThunderstoreZipPath>$(MSBuildProjectDirectory)\package\thunderstore\$(LongshipUpgradesPackageName).zip</LongshipUpgradesThunderstoreZipPath>
      <LongshipUpgradesThunderstoreManifestPath>$(LongshipUpgradesThunderstorePackageDir)manifest.json</LongshipUpgradesThunderstoreManifestPath>
      <LongshipUpgradesNexusPackageDir>$(MSBuildProjectDirectory)\package\nexus\$(LongshipUpgradesPackageName)\</LongshipUpgradesNexusPackageDir>
      <LongshipUpgradesNexusZipPath>$(MSBuildProjectDirectory)\package\nexus\$(LongshipUpgradesPackageName).zip</LongshipUpgradesNexusZipPath>
      <LongshipUpgradesEnglishLocalizationSource>$(MSBuildProjectDirectory)\translations\English.json</LongshipUpgradesEnglishLocalizationSource>
      <LongshipUpgradesEnglishLocalizationFileName>Longship Upgrades.English.json</LongshipUpgradesEnglishLocalizationFileName>
      <LongshipUpgradesYamlDotNetPath>$(TargetDir)YamlDotNet.dll</LongshipUpgradesYamlDotNetPath>
    </PropertyGroup>
  </Target>

  <Target Name="PackageLongshipUpgrades" AfterTargets="Build" DependsOnTargets="InitializeLongshipUpgradesPackageProperties">
    <Error Condition="!Exists('$(TargetPath)')" Text="Built LongshipUpgrades assembly was not found: $(TargetPath)" />
    <Error Condition="!Exists('$(LongshipUpgradesThunderstoreManifestPath)')" Text="Thunderstore manifest was not found: $(LongshipUpgradesThunderstoreManifestPath)" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\UpdateThunderstoreManifest.ps1')" Text="UpdateThunderstoreManifest.ps1 was not found in the project directory." />
    <Error Condition="!Exists('$(LongshipUpgradesEnglishLocalizationSource)')" Text="English localization was not found: $(LongshipUpgradesEnglishLocalizationSource)" />
    <Error Condition="'$(ResolvedLongshipUpgradesR2ModManProfilePluginsDir)' == ''" Text="r2modman profile plugins directory was not resolved." />

    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="LongshipUpgradesBuiltAssemblyIdentity" />
    </GetAssemblyIdentity>

    <MakeDir Directories="$(LongshipUpgradesThunderstorePackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LongshipUpgradesThunderstorePackageDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(LongshipUpgradesEnglishLocalizationSource)" DestinationFiles="$(LongshipUpgradesThunderstorePackageDir)$(LongshipUpgradesEnglishLocalizationFileName)" OverwriteReadOnlyFiles="true" />
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\UpdateThunderstoreManifest.ps1&quot; -ManifestPath &quot;$(LongshipUpgradesThunderstoreManifestPath)&quot; -AssemblyVersion &quot;%(LongshipUpgradesBuiltAssemblyIdentity.Version)&quot;" />
    <ZipDirectory SourceDirectory="$(LongshipUpgradesThunderstorePackageDir)" DestinationFile="$(LongshipUpgradesThunderstoreZipPath)" Overwrite="true" />
    <Message Text="Detected package version from DLL: %(LongshipUpgradesBuiltAssemblyIdentity.Version)" Importance="High" />
    <Message Text="Thunderstore package directory updated: $(LongshipUpgradesThunderstorePackageDir)" Importance="High" />
    <Message Text="Thunderstore archive created: $(LongshipUpgradesThunderstoreZipPath)" Importance="High" />

    <MakeDir Directories="$(ResolvedLongshipUpgradesR2ModManProfilePluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResolvedLongshipUpgradesR2ModManProfilePluginsDir)" OverwriteReadOnlyFiles="true" />
    <Message Text="Copied LongshipUpgrades.dll to r2modman profile: $(ResolvedLongshipUpgradesR2ModManProfilePluginsDir)" Importance="High" />

    <Error Condition="!Exists('$(LongshipUpgradesYamlDotNetPath)')" Text="YamlDotNet.dll was not found for the Nexus ILRepack step: $(LongshipUpgradesYamlDotNetPath)" />
    <MakeDir Directories="$(LongshipUpgradesNexusPackageDir)" />
    <ItemGroup>
      <LongshipUpgradesNexusInputAssemblies Include="$(TargetPath)" />
      <LongshipUpgradesNexusInputAssemblies Include="$(LongshipUpgradesYamlDotNetPath)" />
    </ItemGroup>
    <ILRepack Parallel="true" DebugInfo="true" Internalize="true" InputAssemblies="@(LongshipUpgradesNexusInputAssemblies)" OutputFile="$(LongshipUpgradesNexusPackageDir)$(TargetFileName)" TargetKind="SameAsPrimaryAssembly" LibraryPath="$(TargetDir)" />

    <Copy SourceFiles="$(LongshipUpgradesEnglishLocalizationSource)" DestinationFiles="$(LongshipUpgradesNexusPackageDir)$(LongshipUpgradesEnglishLocalizationFileName)" OverwriteReadOnlyFiles="true" />
    <ZipDirectory SourceDirectory="$(LongshipUpgradesNexusPackageDir)" DestinationFile="$(LongshipUpgradesNexusZipPath)" Overwrite="true" />
    <Message Text="Copied repacked DLL to Nexus package folder." Importance="High" />
    <Message Text="Nexus archive created: $(LongshipUpgradesNexusZipPath)" Importance="High" />
  </Target>
</Project>
